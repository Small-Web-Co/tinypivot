{
  "name": "@smallwebco/tinypivot-core",
  "type": "module",
  "version": "1.4.2",
  "description": "Core logic for TinyPivot - framework agnostic utilities for AI-enabled data grids, pivot tables, and embedded analytics",
  "author": "Small Web, LLC",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/Small-Web-Co/tinypivot",
  "repository": {
    "type": "git",
    "url": "https://github.com/Small-Web-Co/tinypivot.git"
  },
  "bugs": {
    "url": "https://github.com/Small-Web-Co/tinypivot/issues"
  },
  "keywords": [
    "ai-data-analyst",
    "embedded-analytics",
    "natural-language-query",
    "text-to-sql",
    "pivot-table",
    "pivot",
    "datagrid",
    "data-grid",
    "aggregation",
    "excel",
    "spreadsheet",
    "data-table",
    "csv-export"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./d3": {
      "types": "./dist/d3/index.d.ts",
      "import": "./dist/d3/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0",
    "d3-geo": "^3.1.2",
    "d3-hierarchy": "^3.1.3",
    "d3-scale": "^4.0.3",
    "d3-selection": "^3.0.1",
    "d3-shape": "^3.2.1",
    "d3-transition": "^3.0.2",
    "exceljs": "^4.4.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.13",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-transition": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "~5.3.3"
  }
}
