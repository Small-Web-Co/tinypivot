{
  "name": "@smallwebco/tinypivot-mcp",
  "mcpName": "io.github.Small-Web-Co/tinypivot",
  "type": "module",
  "version": "0.9.2",
  "description": "TinyPivot MCP Server, Interactive MCP App & Claude Plugin \u2014 turn CSV, JSON, API/MCP outputs, and queries from any database into interactive charts, pivot tables, terminal cards, live TUI, drill-through, and Excel exports inside AI agents.",
  "author": "Small Web, LLC",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://tiny-pivot.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Small-Web-Co/tinypivot.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "mcp-app",
    "model-context-protocol",
    "claude-plugin",
    "claude-code",
    "tinypivot",
    "pivot-table",
    "data-grid",
    "analytics",
    "charts",
    "tui",
    "csv",
    "sql",
    "bigquery",
    "snowflake",
    "duckdb",
    "mysql",
    "postgres",
    "excel",
    "ai-workflows",
    "pi-package"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "pi": {
    "extensions": [
      "./dist/pi/tinypivot.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "bin": {
    "tinypivot-mcp": "./dist/cli.js"
  },
  "files": [
    ".claude-plugin",
    ".mcp.json",
    "LICENSE.md",
    "README.md",
    "dist",
    "hooks",
    "rules",
    "server.json",
    "skills"
  ],
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:app",
    "build:app": "vite build --config vite.app.config.ts",
    "build:server": "tsup",
    "dev:app": "vite --config vite.app.config.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.0",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "codemirror": "^6.0.2",
    "smol-toml": "^1.9.1",
    "sql-formatter": "^15.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@duckdb/node-api": "2.0.1-r.1",
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@smallwebco/tinypivot-core": "workspace:*",
    "@smallwebco/tinypivot-react": "workspace:*",
    "@smallwebco/tinypivot-server": "workspace:*",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.1",
    "typescript": "~5.6.2",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
