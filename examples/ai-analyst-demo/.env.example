# PostgreSQL Database URL (Required)
DATABASE_URL=postgresql://user:password@localhost:5432/your_database

# AI API Key (Required for AI Data Analyst)
# Supports: OpenAI (sk-...), Anthropic (sk-ant-...), OpenRouter (sk-or-...)
AI_API_KEY=sk-your-api-key-here

# Optional: Override the default AI model
# Provider is auto-detected from API key format
# Defaults: OpenAI=gpt-4o-mini, Anthropic=claude-3-haiku, OpenRouter=anthropic/claude-3-haiku
# AI_MODEL=google/gemini-2.0-flash-001

# Optional: TinyPivot Pro License Key (for AI Analyst features)
# Get one at: https://tiny-pivot.com/#pricing
# VITE_TINYPIVOT_LICENSE_KEY=TP-PRO1-...

# Required in production: Bearer token clients must send in the
# Authorization header. Without it, the server refuses to start when
# NODE_ENV=production.
# TINYPIVOT_API_TOKEN=change-me

# Optional: comma-separated browser origins allowed to call the API.
# localhost origins are always allowed during development.
# ALLOWED_ORIGINS=http://localhost:5173

# Optional: reject SQL the parser cannot understand (fail closed).
# STRICT_SQL_VALIDATION=1
